# Salin ke .env.production (JANGAN commit). Buat secret: openssl rand -hex 24  (hex: aman dipakai di URL koneksi tanpa encoding)
APP_DOMAIN=cari.example.com
POSTGRES_USER=socialfinder
POSTGRES_PASSWORD=
POSTGRES_DB=socialfinder
REDIS_PASSWORD=
# Minimal 32 karakter. Mengganti nilai ini membuat hash IP di audit tidak bisa dicocokkan dengan yang lama.
SESSION_SECRET=
# SMTP untuk email reset password dan verifikasi. Contoh: smtps://pengguna:password@smtp.penyedia.com:465
# (karakter khusus di password harus di-URL-encode). Wajib di production.
SMTP_URL=
MAIL_FROM="Social Finder <no-reply@cari.example.com>"
