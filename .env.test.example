# Salin ke .env.test. Database HARUS berakhiran _test: tes integrasi menghapus semua tabel.
# Buat: docker compose exec postgres createdb -U socialfinder socialfinder_test
# Migrasi: DATABASE_URL=... pnpm db:deploy   (atau: pnpm exec dotenv -e .env.test -- pnpm db:deploy)
DATABASE_URL=postgresql://socialfinder:GANTI_PASSWORD@localhost:5432/socialfinder_test
