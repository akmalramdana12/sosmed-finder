# Salin ke .env dan isi. JANGAN commit .env.
# Buat secret acak:  openssl rand -base64 48

POSTGRES_USER=socialfinder
POSTGRES_PASSWORD=
POSTGRES_DB=socialfinder

# Harus konsisten dengan nilai POSTGRES_* di atas
DATABASE_URL=postgresql://socialfinder:GANTI_PASSWORD@localhost:5432/socialfinder
REDIS_URL=redis://localhost:6379

# Wajib, minimal 32 karakter. Dipakai untuk HMAC IP dan key rate limit.
SESSION_SECRET=

# Origin yang boleh melakukan POST (proteksi CSRF). Pisahkan koma bila lebih dari satu.
APP_ORIGIN=http://localhost:3000

# true HANYA bila di belakang tepat satu reverse proxy tepercaya yang menambahkan X-Forwarded-For
TRUST_PROXY=false

# Opsional di development: tanpa SMTP_URL, email (tautan reset/verifikasi) ditulis ke stdout server.
# Wajib di production.
SMTP_URL=
# Pencarian hanya untuk akun dengan email terverifikasi (default true; false ditolak di production).
# Set false hanya di development tanpa kotak surat.
# REQUIRE_VERIFIED_EMAIL=true
MAIL_FROM=
